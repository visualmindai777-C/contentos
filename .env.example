# Postgres. Supabase: usa la cadena del pooler (puerto 6543), la conexión directa es IPv6.
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# Protege la API (cabecera X-API-Key). Vacío = sin protección (solo desarrollo).
API_KEY=

# Base pública de los artefactos en R2 (Worker o dominio del bucket)
ASSETS_BASE_URL=

CORS_ORIGINS=http://localhost:3000

# Pipeline (FASE 6-8)
REDIS_URL=
OPENROUTER_API_KEY=
POLLINATIONS_TOKEN=
# Los IDs :free cambian con frecuencia; el pipeline descarta al arrancar los que ya no existen
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=contentos
TTS_VOICE=ef_dora
TTS_LANG=e

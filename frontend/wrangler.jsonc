{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contentos-portal",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "BACKEND_URL": "https://CONTENTOS-API.onrender.com",
    "WORKER_URL": "https://contentos-worker.CUENTA.workers.dev"
  }
  // Secrets: API_KEY (la misma del backend), PORTAL_USER y PORTAL_PASSWORD (acceso al portal)
}
